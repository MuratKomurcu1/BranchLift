{
  "name": "branchlift",
  "version": "1.1.0",
  "description": "Stateful backend environments for parallel coding agents and git worktrees.",
  "homepage": "https://github.com/muratkomurcu/BranchLift#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muratkomurcu/BranchLift.git"
  },
  "bugs": {
    "url": "https://github.com/muratkomurcu/BranchLift/issues"
  },
  "type": "module",
  "bin": {
    "branchlift": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "docs",
    "examples",
    "compatibility",
    "benchmarks",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "test:e2e": "BRANCHLIFT_E2E=1 npm test",
    "test:compat": "npm run build && node scripts/compatibility.mjs",
    "benchmark:synthetic": "npm run build && node scripts/benchmark-synthetic.mjs",
    "benchmark:docmost": "npm run build && node scripts/benchmark-docmost.mjs",
    "verify": "npm run check && npm test && npm audit --audit-level=high && npm pack --dry-run",
    "start": "node dist/src/cli.js",
    "prepack": "npm run build"
  },
  "keywords": [
    "ai-agents",
    "git-worktree",
    "docker-compose",
    "database-branching",
    "development-environments"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.2"
  }
}
