{
  "name": "branchlift",
  "version": "1.4.0",
  "description": "Versioned backend state for parallel AI coding agents and Git worktrees.",
  "homepage": "https://github.com/MuratKomurcu1/BranchLift#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MuratKomurcu1/BranchLift.git"
  },
  "bugs": {
    "url": "https://github.com/MuratKomurcu1/BranchLift/issues"
  },
  "type": "module",
  "bin": {
    "branchlift": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "docs",
    "examples",
    "compatibility",
    "evidence",
    "benchmarks",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "test:e2e": "BRANCHLIFT_E2E=1 npm test",
    "test:e2e:mongo-kafka": "npm run build && BRANCHLIFT_MONGO_KAFKA_E2E=1 node --test dist/test/mongo-kafka-e2e.test.js",
    "test:compat": "npm run build && node scripts/compatibility.mjs",
    "benchmark:synthetic": "npm run build && node scripts/benchmark-synthetic.mjs",
    "benchmark:docmost": "npm run build && node scripts/benchmark-docmost.mjs",
    "evidence:project": "npm run build && node scripts/real-project-evidence.mjs",
    "verify": "npm run check && npm test && npm audit --audit-level=high && npm pack --dry-run",
    "start": "node dist/src/cli.js",
    "prepack": "npm run build"
  },
  "keywords": [
    "ai-agents",
    "coding-agents",
    "codex",
    "claude-code",
    "git-worktree",
    "docker-compose",
    "database-branching",
    "database-snapshots",
    "state-isolation",
    "development-environments"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.9.2"
  }
}
